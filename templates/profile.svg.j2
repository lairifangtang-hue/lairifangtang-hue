<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{ width }} {{ height }}" role="img" aria-labelledby="title desc">
  <title id="title">{{ card_title }}</title>
  <desc id="desc">{{ card_description }}</desc>
  <defs>
    <linearGradient id="panel-glow" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="{{ theme.panel_glow_start }}"/>
      <stop offset="100%" stop-color="{{ theme.panel_glow_end }}"/>
    </linearGradient>
  </defs>

  <rect width="{{ width }}" height="{{ height }}" rx="28" fill="{{ theme.page_bg }}"/>
  <rect x="24" y="24" width="{{ width - 48 }}" height="{{ height - 48 }}" rx="24" fill="{{ theme.panel_bg }}" stroke="{{ theme.panel_border }}"/>
  <rect x="24" y="24" width="{{ width - 48 }}" height="58" rx="24" fill="url(#panel-glow)"/>
  <path d="M48 82h{{ width - 96 }}" stroke="{{ theme.panel_border }}"/>

  <circle cx="58" cy="53" r="6" fill="{{ theme.red }}"/>
  <circle cx="80" cy="53" r="6" fill="{{ theme.yellow }}"/>
  <circle cx="102" cy="53" r="6" fill="{{ theme.green }}"/>
  <text x="126" y="58" fill="{{ theme.muted }}" font-size="18" font-family="{{ font_family }}">profile.svg</text>

  <rect x="54" y="112" width="292" height="{{ height - 166 }}" rx="18" fill="{{ theme.ascii_bg }}" stroke="{{ theme.panel_border }}"/>
  <path d="M380 112v{{ height - 166 }}" stroke="{{ theme.panel_border }}"/>

  <text x="84" y="156" fill="{{ theme.ascii_accent }}" font-size="17" xml:space="preserve" font-family="{{ font_family }}">
{% for line in ascii_lines %}
    <tspan x="84" y="{{ 156 + (loop.index0 * line_height) }}">{{ line }}</tspan>
{% endfor %}
  </text>

  <text x="414" y="150" fill="{{ theme.text }}" font-size="18" xml:space="preserve" font-family="{{ font_family }}">
{% for line in info_lines %}
    <tspan x="414" y="{{ 150 + (loop.index0 * line_height) }}">{{ line }}</tspan>
{% endfor %}
  </text>
</svg>
